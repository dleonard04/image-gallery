#!/usr/bin/make -f

export DH_VERBOSE=1

PKG = image-gallery

# Packaged Perl goes in the vendor dirs (/usr/bin, /usr/share/perl5); the
# source Makefile defaults to the site dirs (/usr/local), which Debian policy
# forbids a package from shipping to (dh_usrlocal enforces this).
VENDORBIN := $(shell perl -MConfig -e 'print $$Config{installvendorbin}')
VENDORLIB := $(shell perl -MConfig -e 'print $$Config{installvendorlib}')

%:
	dh $@

# The source tree has no build or test step.
override_dh_auto_build:
override_dh_auto_test:

# Must stay empty: the top Makefile's `clean` deletes ../*.deb and the rpm/ant
# staging, which is not dh's to do. dh_clean handles the packaging cleanup.
override_dh_auto_clean:

# Install via the source tree's own Makefile, staging into the package dir.
override_dh_auto_install:
	$(MAKE) -C src install \
		INSTALL_BIN=$(CURDIR)/debian/$(PKG)$(VENDORBIN) \
		INSTALL_LIB=$(CURDIR)/debian/$(PKG)$(VENDORLIB)/Image
